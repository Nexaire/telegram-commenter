TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=replace_me
TELEGRAM_SESSION=/data/monitor.session

DATABASE_PATH=/data/monitor.db
CHANNELS_CONFIG=/app/config/channels.yaml
LOG_LEVEL=INFO

# true: только записывать совпадения в БД и лог; false: публиковать в целевой канал.
DRY_RUN=true
MONITOR_LOOKBACK_HOURS=24
MONITOR_POLL_SECONDS=300

# Бот публикует заявки, показывает inline-кнопки и отправляет утренний отчёт.
LEAD_BOT_TOKEN=123456:replace_me
# Telegram user ID пользователей, которым разрешено менять статусы.
MANAGER_USER_IDS=123456789
REPORT_TIMEZONE=Europe/Moscow
REPORT_HOUR=9
REPORT_MINUTE=0
